<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
		https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="005-link-treino-to-user" author="codex">
		<addColumn tableName="treinos">
			<column name="app_user_id" type="BIGINT"/>
		</addColumn>

		<sql>
			INSERT INTO app_users (username, password_hash, created_at)
			SELECT 'migration-user', 'migration-user', CURRENT_TIMESTAMP
			WHERE NOT EXISTS (SELECT 1 FROM app_users);
		</sql>

		<sql>
			UPDATE treinos
			SET app_user_id = (SELECT MIN(id) FROM app_users)
			WHERE app_user_id IS NULL;
		</sql>

		<addNotNullConstraint tableName="treinos" columnName="app_user_id" columnDataType="BIGINT"/>
		<addForeignKeyConstraint baseTableName="treinos"
			baseColumnNames="app_user_id"
			constraintName="fk_treinos_app_user"
			referencedTableName="app_users"
			referencedColumnNames="id"/>
	</changeSet>
</databaseChangeLog>
